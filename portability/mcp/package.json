{
  "name": "@coocle/portability-mcp",
  "version": "0.1.0",
  "description": "MCP server for the Google Data Portability API — export your Google data via Claude",
  "type": "module",
  "bin": {
    "coocle-portability-mcp": "./dist/server.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "google",
    "data-portability",
    "gdpr",
    "takeout",
    "claude"
